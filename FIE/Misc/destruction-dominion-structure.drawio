        <mxCell id="snwEAf8KMriEHcRnaeGW-1" value="&lt;font style=&quot;font-size: 30px;&quot;&gt;Домініон Руйнування&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeWidth=1;" vertex="1" parent="1">
