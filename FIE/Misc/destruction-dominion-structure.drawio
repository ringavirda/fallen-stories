        <mxCell id="snwEAf8KMriEHcRnaeGW-2" value="&lt;div&gt;Мунлайт Шадоу&lt;/div&gt;&lt;div&gt;Ранг: &lt;b&gt;Принцеса&lt;/b&gt;&lt;/div&gt;" style="shape=trapezoid;perimeter=trapezoidPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeWidth=1;" vertex="1" parent="1">
